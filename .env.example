# ElevenLabs-Zugangsdaten für scripts/generate-tts.mjs.
# Kopieren nach .env (bleibt lokal, ist in .gitignore) und ausfüllen.

# API-Key: elevenlabs.io -> Profilbild (unten links) -> API keys -> Create
ELEVENLABS_API_KEY=

# Voice-IDs: elevenlabs.io -> VoiceLab -> Stimme auswählen -> "..." -> Copy Voice ID
# Buchstabino und Zahlofant bekommen bewusst unterschiedliche Stimmen (siehe
# scripts/tts-texts.mjs).
ELEVENLABS_VOICE_ID_BUCHSTABINO=
ELEVENLABS_VOICE_ID_ZAHLOFANT=

# Optional: überschreibt das Standardmodell (eleven_v3) in
# scripts/generate-tts.mjs, z.B. falls das im aktuellen Plan gesperrt ist.
# ELEVENLABS_MODEL=eleven_v3

# Optional: Sprechgeschwindigkeit (0.7-1.2, Default 0.85 - langsamer für
# Kinder als der API-Standard 1.0).
# ELEVENLABS_SPEED=0.85
